# Copy this file to .env and change the values. .env is ignored by git (IR-04).
# Never commit real passwords or keys. CI uses GitHub Secrets (IR-05).

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=pantrychef
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=pantrychef
POSTGRES_PORT=5432

# Backend connection to the database above. Keep it in sync with the values above.
DATABASE_URL=postgresql://pantrychef:change-me-local-only@localhost:5432/pantrychef
